#!/bin/sh
# pre-commit: reject the commit if any staged file contains TODO or FIXME.
# Checks the staged (index) version of each added/copied/modified file.
# The .githooks folder is skipped because these scripts mention the words.

status=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$file" in .githooks/*) continue ;; esac
  matches=$(git show ":$file" | grep -nE 'TODO|FIXME')
  if [ -n "$matches" ]; then
    echo "pre-commit: '$file' contains TODO/FIXME:"
    echo "$matches" | sed 's/^/    line /'
    status=1
  fi
done

if [ $status -ne 0 ]; then
  echo "pre-commit: commit rejected. Remove TODO/FIXME and try again."
fi
exit $status
